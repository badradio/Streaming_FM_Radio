# Browser-exposed live origin. Leave empty to see the "stream not connected" state.
# Once Mark has a Live365 account, this is their public mount (not a secret), e.g.
# PUBLIC_STREAM_URL=https://streaming.live365.com/aXXXXX
PUBLIC_STREAM_URL=

# Shared desk password. No user accounts. Required for /admin.
# Set this locally and as a Wrangler secret in production. There is no default.
ADMIN_PASSWORD=

# Optional. Overrides Live365 station id if the mount URL is not
# https://streaming.live365.com/<id> (example id shape: a58480).
LIVE365_STATION_ID=

# Cloudflare Web Analytics beacon token ONLY (hex from data-cf-beacon).
# Do not paste the whole <script> blob — token-only is correct. Runtime will
# extract hex if a snippet was pasted. Worker plaintext var on **badradio**.
# Leave empty to skip the beacon. Never put emails in analytics events.
PUBLIC_CF_BEACON_TOKEN=

# Optional GA4 fallback if Web Analytics is not on the zone. Measurement id only (G-…).
PUBLIC_GA_MEASUREMENT_ID=

# Optional. Resend API key so new Outpost signups email support@badradio.com.
# Production: wrangler secret put RESEND_API_KEY on Worker badradio.
# Leave unset — signup still works, no mail is sent.
# RESEND_API_KEY=

# Optional Worker plaintext vars. Defaults shown.
# NOTIFY_TO=support@badradio.com
# NOTIFY_FROM=onboarding@resend.dev
# After verifying send.badradio.com in Resend:
# NOTIFY_FROM=outpost@send.badradio.com
