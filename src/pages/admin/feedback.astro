---
import Base from '../../layouts/Base.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

export const prerender = false;
---

<Base
  title="Feedback desk — Bad Radio"
  description="Listener votes and short notes. Requires the feedback desk key."
>
  <SiteHeader current="listen" />
  <main id="main" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-muted">Operator</p>
    <h1 class="mt-3 font-display text-4xl font-extrabold tracking-tight">Listener feedback</h1>
    <p class="mt-4 max-w-2xl font-serif text-lg text-ink/85">
      Votes and typed notes only. No voice, no transcripts, no IPs. Paste the feedback desk key to load the tables.
    </p>

    <form data-feedback-admin-auth class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-end">
      <label class="block min-w-[16rem] flex-1">
        <span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted">Feedback desk key</span>
        <input
          type="password"
          name="key"
          required
          autocomplete="off"
          class="mt-1 w-full border border-line bg-void px-3 py-2 font-mono text-sm text-ink outline-none focus:border-amber"
        />
      </label>
      <button
        type="submit"
        class="border border-amber px-3 py-2 font-mono text-xs uppercase tracking-[0.14em] text-amber hover:bg-amber hover:text-void"
      >
        Open tables
      </button>
    </form>
    <p data-feedback-admin-status class="mt-3 font-serif text-ink/80" role="status" aria-live="polite"></p>

    <div data-feedback-admin-tables hidden class="mt-10 space-y-10">
      <section>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="font-display text-2xl font-bold tracking-tight">Votes</h2>
          <label class="block min-w-[12rem]">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted">Artist filter</span>
            <input
              type="search"
              data-feedback-artist
              placeholder="Taylor"
              class="mt-1 w-full border border-line bg-void px-3 py-2 font-mono text-sm text-ink outline-none focus:border-amber"
            />
          </label>
        </div>
        <div class="mt-4 overflow-x-auto border border-line">
          <table class="min-w-full text-left font-mono text-sm">
            <thead class="bg-panel text-[0.65rem] uppercase tracking-[0.14em] text-muted">
              <tr>
                <th class="px-3 py-2">Artist</th>
                <th class="px-3 py-2">Title</th>
                <th class="px-3 py-2">Up</th>
                <th class="px-3 py-2">Down</th>
                <th class="px-3 py-2">Net</th>
                <th class="px-3 py-2">Last voted</th>
              </tr>
            </thead>
            <tbody data-feedback-votes>
              <tr>
                <td class="px-3 py-3 font-serif text-ink/80" colspan="6">Enter the key to load votes.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <section>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <h2 class="font-display text-2xl font-bold tracking-tight">Notes</h2>
          <label class="block min-w-[12rem]">
            <span class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-muted">Kind</span>
            <select
              data-feedback-kind
              class="mt-1 w-full border border-line bg-void px-3 py-2 font-mono text-sm text-ink outline-none focus:border-amber"
            >
              <option value="">All</option>
              <option value="where_i_am">Where I am</option>
              <option value="request">Request</option>
              <option value="dedication">Dedication</option>
            </select>
          </label>
        </div>
        <div class="mt-4 overflow-x-auto border border-line">
          <table class="min-w-full text-left font-mono text-sm">
            <thead class="bg-panel text-[0.65rem] uppercase tracking-[0.14em] text-muted">
              <tr>
                <th class="px-3 py-2">When</th>
                <th class="px-3 py-2">Kind</th>
                <th class="px-3 py-2">Note</th>
                <th class="px-3 py-2">Track</th>
                <th class="px-3 py-2">From</th>
              </tr>
            </thead>
            <tbody data-feedback-messages>
              <tr>
                <td class="px-3 py-3 font-serif text-ink/80" colspan="5">Enter the key to load notes.</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>
  <SiteFooter />
</Base>

<script>
  const STORAGE = 'br_feedback_admin_key';
  const KINDS: Record<string, string> = {
    where_i_am: 'Where I am',
    request: 'Request',
    dedication: 'Dedication',
  };

  type TrackRow = {
    artist: string;
    title: string;
    startedAt?: string;
    up: number;
    down: number;
    net: number;
    lastVoted: string;
  };
  type NoteRow = {
    createdAt: string;
    createdCt?: string;
    kind: string;
    body: string;
    artist?: string | null;
    title?: string | null;
    city?: string | null;
    country?: string | null;
  };

  function cell(text: string, extra = '') {
    const td = document.createElement('td');
    td.className = `px-3 py-2 text-ink/90 ${extra}`;
    td.textContent = text;
    return td;
  }

  function emptyRow(cols: number, text: string) {
    const tr = document.createElement('tr');
    const td = document.createElement('td');
    td.colSpan = cols;
    td.className = 'px-3 py-3 font-serif text-ink/80';
    td.textContent = text;
    tr.append(td);
    return tr;
  }

  function init() {
    const form = document.querySelector<HTMLFormElement>('[data-feedback-admin-auth]');
    const status = document.querySelector<HTMLElement>('[data-feedback-admin-status]');
    const tables = document.querySelector<HTMLElement>('[data-feedback-admin-tables]');
    const votesBody = document.querySelector<HTMLElement>('[data-feedback-votes]');
    const notesBody = document.querySelector<HTMLElement>('[data-feedback-messages]');
    const artist = document.querySelector<HTMLInputElement>('[data-feedback-artist]');
    const kind = document.querySelector<HTMLSelectElement>('[data-feedback-kind]');
    const keyInput = form?.querySelector<HTMLInputElement>('input[name="key"]');
    if (!form || !status || !tables || !votesBody || !notesBody || !keyInput) return;

    const saved = sessionStorage.getItem(STORAGE) ?? '';
    if (saved) keyInput.value = saved;

    const headers = () => ({
      Accept: 'application/json',
      'x-feedback-key': keyInput.value.trim(),
    });

    const loadVotes = async () => {
      const query = artist?.value.trim() ? `?artist=${encodeURIComponent(artist.value.trim())}` : '';
      const response = await fetch(`/api/feedback/summary${query}`, { headers: headers() });
      const data = (await response.json()) as { ok?: boolean; error?: string; tracks?: TrackRow[] };
      if (!data.ok) throw new Error(data.error || 'Could not load votes.');
      const rows = data.tracks ?? [];
      votesBody.replaceChildren();
      if (rows.length === 0) {
        votesBody.append(emptyRow(6, 'No votes yet.'));
        return;
      }
      for (const row of rows) {
        const tr = document.createElement('tr');
        tr.className = 'border-t border-line';
        tr.append(
          cell(row.artist),
          cell(row.title, 'font-serif'),
          cell(String(row.up)),
          cell(String(row.down)),
          cell(String(row.net)),
          cell(row.lastVoted),
        );
        votesBody.append(tr);
      }
    };

    const loadNotes = async () => {
      const params = new URLSearchParams({ limit: '100' });
      if (kind?.value) params.set('kind', kind.value);
      const response = await fetch(`/api/feedback/messages?${params}`, { headers: headers() });
      const data = (await response.json()) as { ok?: boolean; error?: string; messages?: NoteRow[] };
      if (!data.ok) throw new Error(data.error || 'Could not load notes.');
      const rows = data.messages ?? [];
      notesBody.replaceChildren();
      if (rows.length === 0) {
        notesBody.append(emptyRow(5, 'No notes yet.'));
        return;
      }
      for (const row of rows) {
        const tr = document.createElement('tr');
        tr.className = 'border-t border-line';
        const place = [row.city, row.country].filter(Boolean).join(', ') || '—';
        const track = row.artist || row.title ? `${row.artist ?? ''} — ${row.title ?? ''}`.trim() : '—';
        tr.append(
          cell(row.createdCt || row.createdAt),
          cell(KINDS[row.kind] ?? row.kind),
          cell(row.body, 'font-serif'),
          cell(track, 'font-serif'),
          cell(place),
        );
        notesBody.append(tr);
      }
    };

    const load = async () => {
      status.textContent = 'Loading…';
      status.classList.remove('text-filament');
      try {
        await Promise.all([loadVotes(), loadNotes()]);
        tables.hidden = false;
        status.textContent = 'Live from D1.';
      } catch (error) {
        tables.hidden = true;
        status.textContent = error instanceof Error ? error.message : 'Could not load feedback.';
        status.classList.add('text-filament');
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const key = keyInput.value.trim();
      if (!key) return;
      sessionStorage.setItem(STORAGE, key);
      void load();
    });
    artist?.addEventListener('change', () => {
      if (keyInput.value.trim()) void loadVotes().catch(() => undefined);
    });
    kind?.addEventListener('change', () => {
      if (keyInput.value.trim()) void loadNotes().catch(() => undefined);
    });

    if (saved) void load();
  }

  init();
</script>
