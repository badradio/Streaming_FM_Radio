---
import type { RecentItem } from './component-props';

interface Props {
  items: RecentItem[];
}

const { items } = Astro.props;
---

<section aria-labelledby="recent-heading" class="border border-line bg-panel px-4 py-4">
  <h2 id="recent-heading" class="font-mono text-xs uppercase tracking-[0.22em] text-muted">
    Recently played
  </h2>
  {
    items.length === 0 ? (
      <p class="mt-3 font-serif text-ink/80">Nothing logged yet. This list is what already aired — not what’s coming.</p>
    ) : (
      <ol class="mt-3 space-y-2 font-mono text-sm">
        {items.map((item) => (
          <li class="text-ink/90">
            <span class="text-dim">{item.artist}</span>
            <span class="text-dim"> — </span>
            {item.title}
          </li>
        ))}
      </ol>
    )
  }
</section>
