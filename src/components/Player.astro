---
interface Props {
  streamUrl: string;
  size?: 'full' | 'compact';
}

const { streamUrl, size = 'full' } = Astro.props;
const connected = streamUrl.length > 0;
const compact = size === 'compact';
---

<div
  class:list={['player shrink-0', compact && 'player-compact']}
  data-player
  data-connected={connected ? 'true' : 'false'}
  data-player-size={size}
>
  <audio data-player-audio preload="none"></audio>

  <button
    type="button"
    data-player-button
    disabled={!connected}
    aria-pressed="false"
    aria-disabled={connected ? undefined : 'true'}
    aria-label={connected ? 'Play live stream' : 'Stream not connected'}
    class:list={[
      'group relative flex items-center justify-center rounded-full border-2 border-amber text-amber transition-colors [-webkit-tap-highlight-color:transparent] enabled:hover:bg-amber enabled:hover:text-void enabled:active:bg-amber/80 enabled:focus-visible:outline-2 enabled:focus-visible:outline-offset-4 enabled:focus-visible:outline-amber disabled:pointer-events-none disabled:border-line disabled:text-dim disabled:opacity-45',
      compact ? 'size-14 sm:size-16' : 'size-36 sm:size-44',
    ]}
  >
    <span class="pointer-events-none absolute inset-2 rounded-full border border-amber/20 group-disabled:border-line/40"></span>
    <svg
      data-icon-play
      class:list={[compact ? 'ml-0.5 size-6' : 'ml-1 size-14 sm:size-16']}
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="currentColor"
    >
      <path d="M8 5.14v13.72L19.5 12 8 5.14z"></path>
    </svg>
    <svg
      data-icon-pause
      class:list={['hidden', compact ? 'size-6' : 'size-14 sm:size-16']}
      viewBox="0 0 24 24"
      aria-hidden="true"
      fill="currentColor"
    >
      <path d="M7 5h4v14H7V5zm6 0h4v14h-4V5z"></path>
    </svg>
  </button>

  <p
    data-player-status
    class:list={[
      compact
        ? 'mt-2 max-w-[7rem] font-mono text-[0.6rem] uppercase tracking-[0.16em] text-muted'
        : 'mt-4 max-w-[16rem] font-mono text-[0.7rem] uppercase tracking-[0.18em] text-muted',
    ]}
    role="status"
    aria-live="polite"
  >
    {
      connected ? (
        'Ready — hit play'
      ) : (
        <>
          Stream not connected
          {
            compact ? null : (
              <span class="mt-1 block normal-case tracking-normal text-dim">
                Set PUBLIC_STREAM_URL to enable the origin.
              </span>
            )
          }
        </>
      )
    }
  </p>

  {
    connected ? (
      <div
        data-stream-picker
        role="radiogroup"
        aria-label="stream"
        class:list={['flex flex-wrap', compact ? 'mt-2 gap-1' : 'mt-3 gap-1.5']}
      >
        <button
          type="button"
          data-stream="aac"
          role="radio"
          aria-checked="true"
          class:list={[
            'border border-amber px-2 font-mono tracking-[0.08em] text-amber hover:bg-amber hover:text-void focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber',
            compact ? 'py-0.5 text-[0.55rem]' : 'py-1 text-[0.65rem]',
          ]}
        >
          aac 96k
        </button>
        <button
          type="button"
          data-stream="mp3"
          role="radio"
          aria-checked="false"
          class:list={[
            'border border-line px-2 font-mono tracking-[0.08em] text-muted hover:border-amber hover:text-amber focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-amber',
            compact ? 'py-0.5 text-[0.55rem]' : 'py-1 text-[0.65rem]',
          ]}
        >
          mp3 192k
        </button>
      </div>
    ) : null
  }
</div>

<script>
  import {
    STREAMS,
    StreamWatchdog,
    canPlayAac,
    readStoredStream,
    resolveStreamId,
    writeStoredStream,
    type PlayerStatus,
    type StreamId,
  } from '../lib/player-stream';

  type NowDetail = { artist?: string; title?: string; art?: string };

  function initPlayer(root: HTMLElement) {
    const audio = root.querySelector<HTMLAudioElement>('[data-player-audio]');
    const button = root.querySelector<HTMLButtonElement>('[data-player-button]');
    const status = root.querySelector<HTMLElement>('[data-player-status]');
    const playIcon = root.querySelector<SVGElement>('[data-icon-play]');
    const pauseIcon = root.querySelector<SVGElement>('[data-icon-pause]');
    if (!audio || !button || !status || !playIcon || !pauseIcon) return;

    const connected = root.dataset.connected === 'true';
    let now: NowDetail = {};
    let streamId: StreamId = 'aac';

    const setStatus = (kind: PlayerStatus | 'ready' | 'dead') => {
      const text =
        kind === 'onair'
          ? 'On air'
          : kind === 'paused'
            ? 'Paused'
            : kind === 'reconnecting'
              ? 'Reconnecting…'
              : kind === 'connecting'
                ? 'Connecting to origin…'
                : kind === 'dead'
                  ? 'Stream not connected'
                  : 'Ready — hit play';
      status.textContent = text;
      status.classList.toggle('text-signal', kind === 'onair');
      status.classList.toggle('pulse-live', kind === 'onair');
      status.classList.toggle('text-amber', kind === 'reconnecting');
      status.classList.toggle('uppercase', kind !== 'reconnecting');
      status.classList.toggle('normal-case', kind === 'reconnecting');
      status.classList.toggle('text-muted', kind !== 'onair' && kind !== 'reconnecting');
    };

    const artworkFor = (art?: string) => {
      const fallback = [
        { src: '/icons/icon-192.png', sizes: '192x192', type: 'image/png' },
        { src: '/icons/icon-512.png', sizes: '512x512', type: 'image/png' },
      ];
      if (art && /^https?:/i.test(art)) {
        return [{ src: art, sizes: '512x512', type: 'image/jpeg' }, ...fallback];
      }
      return fallback;
    };

    const syncMediaSession = (playing: boolean | null) => {
      if (!('mediaSession' in navigator)) return;
      try {
        navigator.mediaSession.metadata = new MediaMetadata({
          title: now.title?.trim() || 'badradio',
          artist: now.artist?.trim() || 'badradio',
          album: 'badradio',
          artwork: artworkFor(now.art),
        });
        if (playing !== null) {
          navigator.mediaSession.playbackState = playing ? 'playing' : 'paused';
        }
      } catch {
        /* lock-screen metadata is best-effort */
      }
    };

    const setWanted = (want: boolean) => {
      button.setAttribute('aria-pressed', String(want));
      button.setAttribute('aria-label', want ? 'Pause live stream' : 'Play live stream');
      playIcon.classList.toggle('hidden', want);
      pauseIcon.classList.toggle('hidden', !want);
      syncMediaSession(want);
    };

    if (!connected) {
      button.disabled = true;
      button.setAttribute('aria-disabled', 'true');
      button.setAttribute('aria-label', 'Stream not connected');
      return;
    }

    const aacOk = canPlayAac(audio);
    streamId = resolveStreamId(readStoredStream(localStorage), aacOk);
    if (!aacOk) {
      const aacButton = root.querySelector<HTMLButtonElement>('[data-stream="aac"]');
      if (aacButton) aacButton.disabled = true;
    }

    const paintPicker = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-stream]').forEach((el) => {
        const selected = el.dataset.stream === streamId;
        el.setAttribute('aria-checked', String(selected));
        el.classList.toggle('border-amber', selected);
        el.classList.toggle('text-amber', selected);
        el.classList.toggle('border-line', !selected);
        el.classList.toggle('text-muted', !selected);
      });
    };

    const watchdog = new StreamWatchdog(audio, {
      getUrl: () => STREAMS[streamId].url,
      onStatus: (kind) => setStatus(kind),
      onWant: (want) => setWanted(want),
    });
    watchdog.bind();
    paintPicker();

    button.addEventListener('click', () => {
      if (watchdog.want) {
        watchdog.pause();
        return;
      }
      window.__badradioTrack?.('play_click');
      watchdog.start();
    });

    root.querySelectorAll<HTMLButtonElement>('[data-stream]').forEach((el) => {
      el.addEventListener('click', () => {
        const next = el.dataset.stream === 'mp3' ? 'mp3' : 'aac';
        if (next === 'aac' && !canPlayAac(audio)) return;
        streamId = next;
        writeStoredStream(localStorage, streamId);
        paintPicker();
        if (watchdog.want) watchdog.start();
      });
    });

    window.addEventListener('badradio:now', ((event: Event) => {
      const detail = (event as CustomEvent<NowDetail>).detail;
      if (!detail || typeof detail !== 'object') return;
      now = detail;
      syncMediaSession(watchdog.want);
    }) as EventListener);

    if ('mediaSession' in navigator) {
      try {
        navigator.mediaSession.setActionHandler('play', () => {
          watchdog.start();
        });
        navigator.mediaSession.setActionHandler('pause', () => {
          watchdog.pause();
        });
        navigator.mediaSession.setActionHandler('stop', () => {
          watchdog.pause();
        });
      } catch {
        /* some browsers reject handlers */
      }
    }
  }

  document.querySelectorAll<HTMLElement>('[data-player]').forEach(initPlayer);
</script>
